# Exclude configuration files with sensitive data
accounts.txt
proxies.txt
sheerIDlink.txt
无资格号.txt
已绑卡号.txt
已验证未绑卡.txt
有资格待验证号.txt
超时或其他错误.txt
sheerID_verified_failed.txt
2fa_codes.txt
sheerid_tool/
config.json
已修改密钥.txt

# Exclude database files
*.db
*.db-journal
*.sqlite
*.sqlite3

# Exclude log files
*.log

# Exclude debug/test files
debug_*.html
step*.png
error*.png

# Exclude all images by default
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.svg
*.ico

# Exception: Keep specific community images
!Telegram.jpg
!Telegram.png
!QQ.jpg
!zanshang.jpg

# Exclude build artifacts and temp files
build/
dist/
*.spec
__pycache__/
*.pyc
temp_config.json
temp_icon.png

# Exclude IDE settings
.idea/
.vscode/
*.swp
*.swo
*~

# Exclude virtual env
venv/
env/

# Exclude OS files
.DS_Store
Thumbs.db
desktop.ini

# Exclude AI/MCP tool cache directories
.serena/
.spec-workflow/
.zcf/

# Exclude backup files
*.txtbak
*.bak
failed_tasks.json

# Node.js 依赖
node_modules/
# pnpm 工程，npm 的锁文件不入库
package-lock.json

# 工具目录
.claude/
.plan/
%USERPROFILE%/

# 临时文件
nul

# PI-Desktop 目标契约产物（本地会话用，不入库）
.pi/

# electron-vite 构建产物
/out/

# SQLite 运行时文件（*.db 已忽略，但 WAL/SHM 后缀不在其列）
*.db-shm
*.db-wal

# AI 协作工具的工作目录（本地会话数据，不入库；与 .pi/ 同类）
.trellis/
.thinkrail/
.agents/
.cursor/
.claude-flow/
